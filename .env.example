# PostgreSQL connection strings (Supabase).
# Copy to .env.local and fill with your project's values.
#
# DATABASE_URL — Prisma runtime queries. Use the Supabase connection pooler
#   (transaction mode, pgbouncer). Append &pgbouncer=true&connection_limit=1.
# DIRECT_URL   — Prisma migrations/introspection. Use session mode (port 5432),
#   which bypasses pgbouncer.
DATABASE_URL=""
DIRECT_URL=""
