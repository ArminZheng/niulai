# Copy values verbatim from Supabase → Settings → Database → connection strings.
# Use the SAME names in Vercel → Settings → Environment Variables.
#
# POSTGRES_PRISMA_URL       — runtime queries (Supabase pooler, port 6543, pgbouncer).
# POSTGRES_URL_NON_POOLING  — migrations/introspect (Supabase pooler, port 5432, session).
#
# The app reads POSTGRES_PRISMA_URL at runtime (see lib/prisma.ts). It does not
# need the service-role / anon keys to query the database via Prisma.
POSTGRES_PRISMA_URL=""
POSTGRES_URL_NON_POOLING=""
